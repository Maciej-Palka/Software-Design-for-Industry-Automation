      <ECState Name="RECIPE_COMPLETE" x="328" y="2088">
        <ECAction Output="RECIPE_COMPLETE" />
      </ECState>
      <ECState Name="START_T1" x="1936" y="1280">
        <ECAction Output="START_T1" />
        <ECAction Output="CNF" />
      </ECState>
      <ECTransition Source="START" Destination="DRAIN_TANK" Condition="RECIPE_START" x="1003.255" y="203.6505">
