        <Attribute Name="Configuration.Transaction.BezierPoints" Value="508.3083,262.6745,510.1223,283.9716" />
      </ECTransition>
      <ECTransition Source="PHASE_2" Destination="START_T2" Condition="REQ [((X4+deltaL) &gt; waterLevelCurrent &gt; (X4-deltaL)) AND ((Y4+deltaT) &gt; waterTempCurrent &gt; (Y4-deltaT)) ]" x="1958.458" y="1943.079">
