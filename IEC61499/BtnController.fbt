        <With Var="reset_flag" />
        <With Var="start_flag" />
        <With Var="mode_flag" />
      </Event>
      <Event Name="CNF_L">
        <With Var="stop_flag" />
        <With Var="reset_flag" />
        <With Var="start_flag" />
        <With Var="mode_flag" />
      </Event>
    </EventOutputs>
