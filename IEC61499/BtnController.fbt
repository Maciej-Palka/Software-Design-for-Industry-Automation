  <Identification Standard="61499-2" />
  <VersionInfo Organization="Schneider Electric" Version="0.0" Author="macie" Date="10/20/2026" Remarks="Template" />
  <InterfaceList>
    <EventInputs>
      <Event Name="REQ_P" Comment="Normal Execution Request">
        <With Var="start" />
        <With Var="reset" />
        <With Var="ack" />
        <With Var="mode" />
        <With Var="stop" />
        <With Var="in_cycle" />
        <With Var="empty" />
      </Event>
      <Event Name="REQ_O">
        <With Var="in_cycle" />
        <With Var="ready_flag" />
        <With Var="init_flag" />
        <With Var="empty" />
      </Event>
      <Event Name="REQ_C">
        <With Var="init_flag" />
      </Event>
      <Event Name="REQ_S">
        <With Var="empty" />
      </Event>
    </EventInputs>
    <EventOutputs>
