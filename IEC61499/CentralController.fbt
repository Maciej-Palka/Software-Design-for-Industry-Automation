      <ECState Name="PUSH" x="1660" y="2236">
        <ECAction Output="PUSHER_EXTEND" />
      </ECState>
      <ECState Name="LUGGAGE_PUSHED" x="916" y="1368">
        <ECAction Output="LIFT_RETRACT" />
      </ECState>
