OutputPair := 2;]]></ST>
    </Algorithm>
    <Algorithm Name="Recipe_2">
      <ST><![CDATA[;
OutputPair := 1;]]></ST>
    </Algorithm>
    <Algorithm Name="ReturnToInit">
      <ST><![CDATA[;
WaterLevel := InitialLevel;
WaterTemp := InitialTemp;
OutputPair := 2;]]></ST>
    </Algorithm>
