<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="5B307F986C0B1448" Name="RP" Comment="Basic Function Block Type" Namespace="Main">
  <Attribute Name="Configuration.FB.IDCounter" Value="0" />
  <Identification Standard="61499-2" />
  <VersionInfo Organization="nxtControl GmbH" Version="0.0" Author="prana" Date="1/4/2020" Remarks="Template" />
  <InterfaceList>
    <EventInputs>
      <Event Name="INIT">
        <With Var="StartButton" />
        <With Var="Receipe1Button" />
        <With Var="Receipe2Button" />
        <With Var="TemperatureSlider" />
        <With Var="WaterLevelSlider" />
        <With Var="StopButton" />
        <With Var="InitialTemp" />
        <With Var="InitialLevel" />
        <With Var="WaterLevelCurrent" />
        <With Var="WaterTempCurrent" />
        <With Var="deltaT" />
        <With Var="deltaL" />
      </Event>
      <Event Name="Start">
        <With Var="StartButton" />
        <With Var="Receipe1Button" />
        <With Var="Receipe2Button" />
        <With Var="TemperatureSlider" />
        <With Var="WaterLevelSlider" />
        <With Var="StopButton" />
        <With Var="InitialTemp" />
        <With Var="InitialLevel" />
        <With Var="WaterLevelCurrent" />
        <With Var="WaterTempCurrent" />
      </Event>
      <Event Name="Receipe1E" Comment="Initialization Request">
        <With Var="Receipe1Button" />
        <With Var="Receipe2Button" />
        <With Var="TemperatureSlider" />
        <With Var="WaterLevelSlider" />
        <With Var="WaterLevelCurrent" />
        <With Var="WaterTempCurrent" />
      </Event>
      <Event Name="Receipe2E" Comment="Normal Execution Request">
        <With Var="Receipe1Button" />
        <With Var="Receipe2Button" />
        <With Var="TemperatureSlider" />
        <With Var="WaterLevelSlider" />
        <With Var="WaterLevelCurrent" />
        <With Var="WaterTempCurrent" />
      </Event>
      <Event Name="SlidersE">
        <With Var="Receipe1Button" />
        <With Var="Receipe2Button" />
        <With Var="TemperatureSlider" />
        <With Var="WaterLevelSlider" />
        <With Var="WaterLevelCurrent" />
        <With Var="WaterTempCurrent" />
      </Event>
      <Event Name="StopE">
        <With Var="StartButton" />
        <With Var="Receipe1Button" />
        <With Var="Receipe2Button" />
        <With Var="TemperatureSlider" />
        <With Var="WaterLevelSlider" />
        <With Var="StopButton" />
        <With Var="InitialTemp" />
        <With Var="InitialLevel" />
        <With Var="WaterLevelCurrent" />
        <With Var="WaterTempCurrent" />
      </Event>
      <Event Name="REQ">
        <With Var="WaterLevelCurrent" />
        <With Var="WaterTempCurrent" />
      </Event>
      <Event Name="RECEIPE_1_COMPLETED" />
      <Event Name="RECEIPE_2_COMPLETED" />
      <Event Name="ALARM">
        <With Var="Overheat" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event Name="INITO" Comment="Initialization Confirm">
        <With Var="WaterLevel" />
        <With Var="WaterTemp" />
      </Event>
      <Event Name="CNF" Comment="Execution Confirmation">
        <With Var="WaterTemp" />
        <With Var="WaterLevel" />
        <With Var="OutputPair" />
      </Event>
      <Event Name="START_RECIPE_1">
        <With Var="OutputPair" />
      </Event>
      <Event Name="START_RECIPE_2">
        <With Var="OutputPair" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="StartButton" Type="BOOL" />
      <VarDeclaration Name="Receipe1Button" Type="BOOL" Comment="Input event qualifier" />
      <VarDeclaration Name="Receipe2Button" Type="BOOL" />
      <VarDeclaration Name="TemperatureSlider" Type="REAL" />
      <VarDeclaration Name="WaterLevelSlider" Type="REAL" />
      <VarDeclaration Name="StopButton" Type="BOOL" />
      <VarDeclaration Name="InitialTemp" Type="REAL" />
      <VarDeclaration Name="InitialLevel" Type="REAL" />
      <VarDeclaration Name="WaterLevelCurrent" Type="REAL" />
      <VarDeclaration Name="WaterTempCurrent" Type="REAL" />
      <VarDeclaration Name="deltaT" Type="REAL" />
      <VarDeclaration Name="deltaL" Type="REAL" />
      <VarDeclaration Name="Overheat" Type="BOOL" />
    </InputVars>
    <OutputVars>
