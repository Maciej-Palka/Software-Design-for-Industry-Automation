    <Algorithm Name="INIT" Comment="Initialization algorithm">
      <ST><![CDATA[;
OutputPair := 2;]]></ST>
    </Algorithm>
    <Algorithm Name="SliderControl">
      <ST><![CDATA[WaterLevel := WaterLevelSlider;
WaterTemp := TemperatureSlider;]]></ST>
    </Algorithm>
    <Algorithm Name="start">
      <ST><![CDATA[WaterLevel := InitialLevel;
WaterTemp := InitialTemp;
OutputPair := 2;]]></ST>
    </Algorithm>
    <Algorithm Name="Stp">
      <ST><![CDATA[WaterLevel := 0;
WaterTemp := 0;
OutputPair := 2;]]></ST>
    </Algorithm>
    <Algorithm Name="X1">
      <ST><![CDATA[

WaterLevel := X1;
WaterTemp := Y2;

]]></ST>
    </Algorithm>
    <Algorithm Name="X2">
      <ST><![CDATA[

WaterLevel := X2;
WaterTemp := Y2;]]></ST>
    </Algorithm>
    <Algorithm Name="Drain">
      <ST><![CDATA[
WaterLevel := 0;
WaterTemp := 0;]]></ST>
    </Algorithm>
    <Algorithm Name="Recipe_1">
      <ST><![CDATA[;
OutputPair := 0;]]></ST>
    </Algorithm>
    <Algorithm Name="ManualOutput">
