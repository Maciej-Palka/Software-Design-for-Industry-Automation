    <Algorithm Name="INIT">
      <ST><![CDATA[ExtendLift:= FALSE;
RetractLift:=TRUE;
LiftExtendedCNF := FALSE;
LiftRetractedCNF := FALSE;]]></ST>
    </Algorithm>
    <Algorithm Name="INITIAL">
      <ST><![CDATA[RetractLift:=FALSE;
LiftExtendedCNF := FALSE;
LiftRetractedCNF := TRUE;]]></ST>
    </Algorithm>
    <Algorithm Name="EXTENDING">
      <ST><![CDATA[ExtendLift:=TRUE;
LiftRetractedCNF := FALSE;]]></ST>
    </Algorithm>
    <Algorithm Name="LUGGAGELIFTED">
      <ST><![CDATA[ExtendLift:=FALSE;
LiftExtendedCNF := TRUE;]]></ST>
    </Algorithm>
    <Algorithm Name="RETRACT">
      <ST><![CDATA[RetractLift:=TRUE;
LiftExtendedCNF := FALSE;]]></ST>
