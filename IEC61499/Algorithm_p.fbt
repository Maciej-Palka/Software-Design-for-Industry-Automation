<!DOCTYPE FBType SYSTEM "../LibraryElement.dtd">
<FBType GUID="c85948ee-15a3-4c88-bef0-07ba281d0cab" Name="Algorithm_p" Comment="Basic Function Block Type" Namespace="Main">
  <Identification Standard="61499-2" />
  <VersionInfo Organization="Schneider Electric" Version="0.0" Author="macie" Date="10/22/2026" Remarks="Template" />
  <InterfaceList>
    <EventInputs>
      <Event Name="REQ" Comment="Normal Execution Request">
        <With Var="retracted" />
        <With Var="extended" />
        <With Var="stop_flag" />
        <With Var="mode" />
      </Event>
      <Event Name="UPDATE">
        <With Var="retracted" />
        <With Var="extended" />
        <With Var="stop_flag" />
        <With Var="mode" />
      </Event>
      <Event Name="MANUAL">
        <With Var="retracted" />
        <With Var="extended" />
        <With Var="stop_flag" />
        <With Var="manual_input" />
        <With Var="mode" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event Name="CNF" Comment="Execution Confirmation">
        <With Var="Retracted" />
      </Event>
      <Event Name="CNF_CYCLE" />
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="retracted" Type="BOOL" Comment="Input event qualifier" />
      <VarDeclaration Name="extended" Type="BOOL" />
      <VarDeclaration Name="stop_flag" Type="BOOL" />
      <VarDeclaration Name="manual_input" Type="BOOL" />
      <VarDeclaration Name="mode" Type="INT" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="Retracted" Type="BOOL" Comment="Output event qualifier" />
    </OutputVars>
  </InterfaceList>
  <BasicFB>
    <Attribute Name="FBType.Basic.Algorithm.Order" Value="RETRACT,EXTEND,MANUAL" />
    <ECC>
